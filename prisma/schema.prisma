generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Division {
  BLUE
  RED
}

enum Gender {
  MALE
  FEMALE
}

enum MemberStatus {
  MEMBER
  NON_MEMBER
}

model League {
  id              Int      @id @default(autoincrement())
  name            String
  shortName       String?
  year            Int
  location        String
  startDate       DateTime
  endDate         DateTime
  qualifyingWeeks Int      @default(9)
  bestScoresCount Int      @default(5)
  minWeeks        Int      @default(5)
  facebookUrl     String?
  facebookLabel   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rounds  Round[]
  players Player[]
}

model CourseLayout {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime @default(now())

  holePars   HolePar[]
  blueRounds Round[]   @relation("BlueLayout")
  redRounds  Round[]   @relation("RedLayout")
}

model HolePar {
  id             Int @id @default(autoincrement())
  courseLayoutId Int
  holeNumber     Int
  par            Int

  courseLayout CourseLayout @relation(fields: [courseLayoutId], references: [id], onDelete: Cascade)

  @@unique([courseLayoutId, holeNumber])
}

model Player {
  id                       Int          @id @default(autoincrement())
  name                     String
  pdgaNumber               String?
  username                 String?
  gender                   Gender?
  memberStatus             MemberStatus @default(NON_MEMBER)
  excludeFromChampionship  Boolean      @default(false)
  championshipPoolOverride String?
  currentTag               String?
  leagueId                 Int
  createdAt                DateTime     @default(now())

  league  League   @relation(fields: [leagueId], references: [id])
  results Result[]

  @@unique([username, leagueId])
}

model Round {
  id             Int      @id @default(autoincrement())
  leagueId       Int
  weekNumber     Int
  date           DateTime
  blueLayoutId   Int?
  redLayoutId    Int?
  notes          String?
  isChampionship Boolean  @default(false)
  isDraft        Boolean  @default(false)
  facebookUrl    String?
  facebookLabel  String?
  udiscUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  league         League                   @relation(fields: [leagueId], references: [id])
  blueLayout     CourseLayout?            @relation("BlueLayout", fields: [blueLayoutId], references: [id])
  redLayout      CourseLayout?            @relation("RedLayout", fields: [redLayoutId], references: [id])
  results        Result[]
  roundWinners   RoundWinner[]
  ctpWinners     CtpWinner[]
  aceWinners     AceWinner[]
  poolWinners    ChampionshipPoolWinner[]
  bobTag         BobTag?
  reactions      RoundReaction[]

  @@unique([leagueId, weekNumber])
}

model Result {
  id            Int      @id @default(autoincrement())
  roundId       Int
  playerId      Int
  division      Division
  position      Int
  score         Int
  relativeScore Int
  holeScores    Json
  tagBefore     String?
  tagAfter      String?
  leftEarly     Boolean  @default(false)
  createdAt     DateTime @default(now())

  round  Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id])

  @@unique([roundId, playerId])
}

model RoundWinner {
  id         Int      @id @default(autoincrement())
  roundId    Int
  division   Division
  place      Int
  playerName String
  prize      String?

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
}

model CtpWinner {
  id         Int     @id @default(autoincrement())
  roundId    Int
  hole       Int
  playerName String
  prize      String?

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
}

model AceWinner {
  id          Int    @id @default(autoincrement())
  roundId     Int
  hole        Int
  playerName  String
  prizeAmount Float?

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
}

model ChampionshipPoolWinner {
  id         Int     @id @default(autoincrement())
  roundId    Int
  pool       String
  place      Int     @default(1)
  playerName String
  prize      String?

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, pool, place])
}

model BobTag {
  id         Int    @id @default(autoincrement())
  roundId    Int    @unique
  playerName String

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
}

model RoundReaction {
  id      Int    @id @default(autoincrement())
  roundId Int
  emoji   String
  target  String @default("round") // "round" | "winners_blue" | "winners_red" | "ctp" | "ace" | "bob" | "pool_A" etc.
  count   Int    @default(0)

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, emoji, target])
}

model PageView {
  id        Int      @id @default(autoincrement())
  path      String
  visitorId String
  referrer  String?
  device    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}
